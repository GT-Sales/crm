{
  "name": "gt-sales-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "proxy-addr@<2.0.8": "2.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^5.0.0": "5.0.12",
      "dompurify@<3.4.16": "3.4.16",
      "js-yaml@^3.0.0": "3.15.2",
      "markdown-it@^14.0.0": "14.3.3",
      "sharp@^0.35.0": "0.35.5",
      "smol-toml@^1.0.0": "1.9.0"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "test:tooling": "node --test scripts/*.test.mjs",
    "check:frontend-db-boundary": "eslint apps/admin",
    "build:affected": "node scripts/affected-builds.mjs --build",
    "test:e2e": "pnpm --filter admin exec playwright test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
