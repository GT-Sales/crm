    "@gt-sales/types": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "catalog:",
    "express": "5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gt-sales/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "postgres": "3.4.9",
    "tsup": "9.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
